{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "policy-acknowledgement-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/policyAcknowledgement/PolicyAcknowledgementWebPart.js",
          "manifest": "./src/webparts/policyAcknowledgement/PolicyAcknowledgementWebPart.manifest.json"
        }
      ]
    },
    "policy-compliance-dashboard-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/policyComplianceDashboard/PolicyComplianceDashboardWebPart.js",
          "manifest": "./src/webparts/policyComplianceDashboard/PolicyComplianceDashboardWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "PolicyAcknowledgementWebPartStrings": "lib/webparts/policyAcknowledgement/loc/{locale}.js",
    "PolicyComplianceDashboardWebPartStrings": "lib/webparts/policyComplianceDashboard/loc/{locale}.js",
    "ControlStrings": "node_modules/@pnp/spfx-controls-react/lib/loc/{locale}.js"
  }
}